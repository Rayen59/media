<!DOCTYPE html>
<html lang="fr" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>NOVA — Assistant IA</title>
<style>
:root{--bg:#fff;--fg:#0a0a0a;--mut:#6b6b6b;--line:#e4e4e4;--card:#f5f5f5;--inv:#0a0a0a;--invfg:#fff;--a4w:794px;--a4h:1123px;color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#000;--fg:#f5f5f5;--mut:#8a8a8a;--line:#222;--card:#0f0f0f;--inv:#fff;--invfg:#000;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#000;--fg:#f5f5f5;--mut:#8a8a8a;--line:#222;--card:#0f0f0f;--inv:#fff;--invfg:#000;color-scheme:dark}
:root[data-theme="light"]{--bg:#fff;--fg:#0a0a0a;--mut:#6b6b6b;--line:#e4e4e4;--card:#f5f5f5;--inv:#0a0a0a;--invfg:#fff;color-scheme:light}
*{box-sizing:border-box;margin:0}
html,body{height:100%}
body{background:var(--bg);color:var(--fg);font-family:Inter,system-ui,-apple-system,"Segoe UI",Helvetica,Arial,sans-serif;overflow:hidden;-webkit-font-smoothing:antialiased}
button,input,textarea,select{font:inherit;color:inherit}
button{cursor:pointer;background:none;border:0}
.hide{display:none!important}
/* INTRO */
#intro{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;padding:20px;overflow:auto;background:var(--bg);z-index:100}
#cv{position:absolute;inset:0;width:100%;height:100%}
#intro::after{content:"";position:absolute;inset:0;background:radial-gradient(circle at 50% 50%,transparent 20%,var(--bg) 85%);pointer-events:none}
.wrap{position:relative;z-index:2;width:100%;max-width:400px;text-align:center}
.logo{font-size:clamp(44px,12vw,72px);font-weight:800;letter-spacing:.35em;padding-left:.35em;display:flex;justify-content:center}
.logo span{opacity:0;transform:translateY(30px) scale(.8);filter:blur(10px);animation:rise .9s cubic-bezier(.2,.8,.2,1) forwards}
@keyframes rise{to{opacity:1;transform:none;filter:none}}
.tag{color:var(--mut);letter-spacing:.25em;font-size:11px;text-transform:uppercase;margin:10px 0 26px;opacity:0;animation:rise 1s 1.2s forwards}
.card{background:color-mix(in srgb,var(--card) 82%,transparent);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border:1px solid var(--line);border-radius:18px;padding:22px;text-align:left;opacity:0;transform:translateY(24px);animation:rise 1s 1.6s forwards}
.tabs{display:grid;grid-template-columns:1fr 1fr;background:var(--bg);border:1px solid var(--line);border-radius:12px;padding:4px;margin-bottom:16px}
.tabs button{padding:9px;border-radius:9px;font-size:14px;color:var(--mut);transition:.25s}
.tabs button.on{background:var(--inv);color:var(--invfg);font-weight:600}
.f{display:block;margin-bottom:12px}
.f small{display:block;color:var(--mut);font-size:12px;margin-bottom:5px}
.f input,.f select{width:100%;background:var(--bg);border:1px solid var(--line);border-radius:10px;padding:12px 14px;font-size:15px;outline:0;transition:.2s}
.f input:focus,.f select:focus{border-color:var(--fg);box-shadow:0 0 0 3px color-mix(in srgb,var(--fg) 12%,transparent)}
.chk{display:flex;gap:10px;align-items:flex-start;font-size:13px;color:var(--mut);margin:14px 0;line-height:1.45}
.chk input{margin-top:3px;accent-color:var(--inv);width:16px;height:16px;flex:none}
.chk a{color:var(--fg);text-decoration:underline;cursor:pointer}
.btn{width:100%;background:var(--inv);color:var(--invfg);border-radius:12px;padding:13px;font-weight:700;font-size:15px;transition:.2s}
.btn:hover{transform:translateY(-1px)}
.btn:disabled{opacity:.35;cursor:not-allowed;transform:none}
.err{color:var(--fg);font-size:13px;margin-top:10px;min-height:18px;text-align:center;border-left:2px solid var(--fg);padding-left:8px;display:none}
.err.on{display:block}
/* MODAL */
.modal{position:fixed;inset:0;background:rgba(0,0,0,.7);z-index:50;display:flex;align-items:center;justify-content:center;padding:18px;backdrop-filter:blur(4px)}
.mbox{background:var(--bg);border:1px solid var(--line);border-radius:18px;max-width:520px;width:100%;max-height:85%;display:flex;flex-direction:column;animation:rise .4s forwards}
.mbox h3{padding:20px 22px 8px;font-size:18px}
.mbody{padding:0 22px;overflow:auto;font-size:14px;line-height:1.6;color:var(--mut)}
.mbody b{color:var(--fg);display:block;margin-top:12px}
.mbox .btn{margin:18px 22px 22px;width:auto}
/* APP */
#app{position:fixed;inset:0;display:flex;background:var(--bg);padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
#side{width:290px;border-right:1px solid var(--line);display:flex;flex-direction:column;background:var(--card);transition:transform .3s cubic-bezier(.2,.8,.2,1);z-index:30;position:relative}
.sh{padding:16px;display:flex;align-items:center;justify-content:space-between}
.brand{font-weight:800;letter-spacing:.3em;font-size:16px}
.ib{width:36px;height:36px;border-radius:10px;display:inline-flex;align-items:center;justify-content:center;border:1px solid var(--line);transition:.2s;flex:none}
.ib:hover{background:var(--inv);color:var(--invfg)}
.ib svg,.send svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.newc{margin:0 16px 12px;padding:11px;border-radius:12px;background:var(--inv);color:var(--invfg);font-weight:700;font-size:14px}
#hist{flex:1;overflow:auto;padding:0 10px}
.hi{display:flex;align-items:center;gap:6px;padding:10px 12px;border-radius:10px;font-size:14px;cursor:pointer;color:var(--mut);animation:rise .4s forwards;opacity:0}
.hi span{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.hi:hover,.hi.on{background:var(--bg);color:var(--fg)}
.hi button{opacity:.5;font-size:16px;width:24px}
.hi button:hover{opacity:1}
.su{padding:14px 16px;border-top:1px solid var(--line);display:flex;align-items:center;gap:10px;font-size:14px}
.av{width:34px;height:34px;border-radius:50%;background:var(--inv);color:var(--invfg);display:flex;align-items:center;justify-content:center;font-weight:700;flex:none}
.su div{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
#main{flex:1;display:flex;flex-direction:column;min-width:0}
.top{display:flex;align-items:center;gap:10px;padding:12px 16px;border-bottom:1px solid var(--line)}
.top h2{font-size:15px;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
#burger{display:none}
#msgs{flex:1;overflow:auto;padding:24px 16px;scroll-behavior:smooth}
.in{max-width:760px;margin:0 auto}
.empty{text-align:center;margin-top:12vh}
.empty .logo{font-size:40px;margin-bottom:12px}
.empty p{color:var(--mut);font-size:15px}
.sug{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin-top:22px}
.sug button{border:1px solid var(--line);border-radius:20px;padding:9px 15px;font-size:13px;color:var(--mut);transition:.2s}
.sug button:hover{background:var(--inv);color:var(--invfg)}
.m{display:flex;gap:12px;margin-bottom:22px;animation:rise .5s forwards;opacity:0}
.m.u{flex-direction:row-reverse}
.m .av{width:30px;height:30px;font-size:12px}
.m.b .av{background:var(--bg);color:var(--fg);border:1px solid var(--fg)}
.bub{max-width:82%;position:relative}
.txt{padding:11px 15px;border-radius:16px;font-size:15px;line-height:1.55;white-space:pre-wrap;word-wrap:break-word}
.u .txt{background:var(--inv);color:var(--invfg);border-bottom-right-radius:4px}
.b .txt{background:var(--card);border:1px solid var(--line);border-bottom-left-radius:4px}
.att{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:6px}
.att img{max-width:220px;max-height:180px;border-radius:12px;border:1px solid var(--line)}
.att .fl{border:1px solid var(--line);border-radius:10px;padding:7px 11px;font-size:12px;background:var(--card);color:var(--fg)}
.del{position:absolute;top:-8px;right:-8px;width:22px;height:22px;border-radius:50%;background:var(--bg);border:1px solid var(--line);font-size:12px;opacity:0;transition:.2s}
.u .del{right:auto;left:-8px}
.m:hover .del{opacity:1}
@media (hover:none){.del{opacity:.8}}
.dots span{display:inline-block;width:6px;height:6px;margin:0 2px;border-radius:50%;background:var(--fg);animation:bn 1s infinite}
.dots span:nth-child(2){animation-delay:.15s}.dots span:nth-child(3){animation-delay:.3s}
@keyframes bn{0%,60%,100%{transform:translateY(0);opacity:.3}30%{transform:translateY(-6px);opacity:1}}
.comp{padding:10px 16px 16px}
.cbox{max-width:760px;margin:0 auto;border:1px solid var(--line);background:var(--card);border-radius:20px;padding:10px;transition:.2s}
.cbox:focus-within{border-color:var(--fg)}
#chips{display:flex;flex-wrap:wrap;gap:6px;padding:0 4px}
#chips:not(:empty){margin-bottom:8px}
.chip{display:flex;align-items:center;gap:6px;border:1px solid var(--line);background:var(--bg);border-radius:10px;padding:4px 8px;font-size:12px;max-width:180px}
.chip img{width:26px;height:26px;border-radius:6px;object-fit:cover}
.chip span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.chip button{font-size:14px;color:var(--mut)}
.row{display:flex;align-items:flex-end;gap:6px}
#inp{flex:1;background:none;border:0;outline:0;resize:none;max-height:140px;padding:9px 6px;font-size:15px;line-height:1.4}
.ib{border:0}
.send{width:38px;height:38px;border-radius:12px;background:var(--inv);color:var(--invfg);display:flex;align-items:center;justify-content:center;flex:none;transition:.2s}
.send:hover{transform:scale(1.07)}
.rec{background:var(--inv)!important;color:var(--invfg)!important;animation:pl 1.1s infinite}
@keyframes pl{0%{box-shadow:0 0 0 0 color-mix(in srgb,var(--fg) 50%,transparent)}100%{box-shadow:0 0 0 14px transparent}}
.note{text-align:center;font-size:11px;color:var(--mut);margin-top:8px}
#toast{position:fixed;bottom:90px;left:50%;transform:translateX(-50%);background:var(--inv);color:var(--invfg);padding:10px 18px;border-radius:12px;font-size:13px;z-index:999;opacity:0;pointer-events:none;transition:.3s}
#toast.on{opacity:1}
/* A4 OVERLAY */
#a4{position:fixed;inset:0;z-index:200;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,.85);backdrop-filter:blur(8px);animation:fadeIn .3s}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
.a4-wrap{position:relative;background:var(--bg);border-radius:12px;overflow:auto;box-shadow:0 20px 60px rgba(0,0,0,.5);max-width:95vw;max-height:95vh;width:var(--a4w);height:var(--a4h);min-width:320px;border:1px solid var(--line)}
.a4-header{position:sticky;top:0;display:flex;align-items:center;justify-content:space-between;padding:12px 18px;background:var(--bg);border-bottom:1px solid var(--line);z-index:2}
.a4-header h3{font-size:16px;letter-spacing:.2em;font-weight:800}
.a4-body{padding:24px;font-size:14px;line-height:1.7;color:var(--fg)}
.a4-page{background:var(--card);border:1px solid var(--line);border-radius:8px;padding:20px;margin-bottom:16px;min-height:200px}
.a4-close{width:36px;height:36px;border-radius:10px;border:1px solid var(--line);display:flex;align-items:center;justify-content:center;font-size:18px;transition:.2s}
.a4-close:hover{background:var(--inv);color:var(--invfg)}
/* Bluetooth device item */
.dev{display:flex;align-items:center;gap:12px;padding:12px 16px;border:1px solid var(--line);border-radius:12px;margin-bottom:8px;background:var(--bg);transition:.2s;animation:rise .4s forwards;opacity:0}
.dev:hover{border-color:var(--fg)}
.dev .ic{width:40px;height:40px;border-radius:10px;background:var(--card);display:flex;align-items:center;justify-content:center;font-size:18px;border:1px solid var(--line)}
.dev .info{flex:1}
.dev .info b{display:block;font-size:14px}
.dev .info small{color:var(--mut);font-size:12px}
.dev .st{font-size:11px;padding:3px 8px;border-radius:8px;background:var(--card);color:var(--mut);border:1px solid var(--line)}
.dev .st.on{background:var(--inv);color:var(--invfg);border-color:var(--inv)}
.dev button{font-size:13px;padding:7px 14px;border-radius:9px;border:1px solid var(--line);transition:.2s}
.dev button:hover{background:var(--inv);color:var(--invfg)}
/* Settings page */
.settings{position:fixed;inset:0;z-index:150;background:var(--bg);overflow:auto;padding:20px;animation:fadeIn .3s}
.settings-inner{max-width:640px;margin:0 auto}
.settings h2{font-size:22px;font-weight:800;letter-spacing:.15em;margin-bottom:20px}
.sec{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:18px;margin-bottom:14px}
.sec h3{font-size:14px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--mut);margin-bottom:12px}
.set-row{display:flex;align-items:center;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--line);font-size:14px;gap:12px}
.set-row:last-child{border-bottom:0}
.set-row small{display:block;color:var(--mut);font-size:12px;margin-top:3px}
.set-row .val{color:var(--mut);font-size:13px}
.toggle{width:44px;height:26px;border-radius:13px;background:var(--line);position:relative;transition:.2s;flex:none;cursor:pointer}
.toggle.on{background:var(--inv)}
.toggle::after{content:"";position:absolute;top:3px;left:3px;width:20px;height:20px;border-radius:50%;background:var(--bg);transition:.2s;box-shadow:0 1px 3px rgba(0,0,0,.2)}
.toggle.on::after{transform:translateX(18px)}
.sel{background:var(--bg);border:1px solid var(--line);border-radius:9px;padding:7px 10px;font-size:13px}
.btn-s{background:var(--inv);color:var(--invfg);border-radius:10px;padding:9px 16px;font-size:13px;font-weight:600}
.btn-o{background:none;border:1px solid var(--line);border-radius:10px;padding:9px 16px;font-size:13px}
.btn-o:hover{background:var(--inv);color:var(--invfg)}
/* BLUETOOTH SCANNER */
#btPanel{position:fixed;inset:0;z-index:180;background:rgba(0,0,0,.85);backdrop-filter:blur(6px);display:flex;align-items:center;justify-content:center;padding:20px;animation:fadeIn .3s}
.bt-box{background:var(--bg);border:1px solid var(--line);border-radius:20px;max-width:480px;width:100%;max-height:85vh;display:flex;flex-direction:column;overflow:hidden}
.bt-h{padding:18px 20px;border-bottom:1px solid var(--line);display:flex;align-items:center;gap:12px}
.bt-h h3{flex:1;font-size:16px;font-weight:700}
.bt-scan{width:100%;padding:14px;background:var(--inv);color:var(--invfg);font-weight:700;font-size:14px;letter-spacing:.05em}
.bt-list{padding:14px;overflow:auto;flex:1}
.scanning{text-align:center;padding:30px;color:var(--mut)}
.pulse{width:60px;height:60px;border-radius:50%;border:2px solid var(--fg);margin:0 auto 16px;animation:pl2 1.5s infinite}
@keyframes pl2{0%{transform:scale(.8);opacity:1}100%{transform:scale(1.6);opacity:0}}
@media(max-width:760px){
#side{position:fixed;inset:0 auto 0 0;transform:translateX(-100%);width:82%;max-width:320px;padding-top:env(safe-area-inset-top,0px)}
#side.open{transform:none}
#burger{display:inline-flex}
.bub{max-width:88%}
.a4-wrap{width:100vw;height:100vh;max-width:100vw;max-height:100vh;border-radius:0}
}
</style>
</head>
<body>

<section id="intro">
<canvas id="cv"></canvas>
<div class="wrap">
  <div class="logo" id="logo"></div>
  <div class="tag">Intelligence artificielle · Nouvelle génération</div>
  <div class="card">
    <div class="tabs"><button id="tL" class="on">Connexion</button><button id="tS">Créer un compte</button></div>
    <label class="f hide" id="fN"><small>Nom complet</small><input id="name" autocomplete="name" placeholder="Votre nom"></label>
    <label class="f"><small>Adresse e-mail</small><input id="email" type="email" autocomplete="email" placeholder="vous@exemple.com"></label>
    <label class="f"><small>Mot de passe</small><input id="pass" type="password" autocomplete="current-password" placeholder="••••••••"></label>
    <label class="chk"><input type="checkbox" id="ok"><span>J’ai lu et j’accepte les <a id="pv">règles de confidentialité</a> et les conditions d’utilisation.</span></label>
    <button class="btn" id="go" disabled>Se connecter</button>
    <div class="err" id="err"></div>
  </div>
</div>
</section>

<div class="modal hide" id="modal"><div class="mbox">
<h3>Règles de confidentialité</h3>
<div class="mbody">
<b>1. Données collectées</b>Nom, adresse e-mail et contenu de vos conversations, uniquement pour faire fonctionner le service.
<b>2. Stockage</b>Vos conversations et fichiers joints sont conservés localement sur votre appareil. Vous pouvez les supprimer à tout moment.
<b>3. Partage</b>Vos données ne sont ni vendues ni partagées avec des tiers à des fins publicitaires.
<b>4. Micro et fichiers</b>Le micro, les photos et les fichiers ne sont utilisés que lorsque vous les activez ou les joignez vous-même.
<b>5. Vos droits</b>Accès, rectification et suppression de vos données à tout moment, y compris la suppression de votre historique.
<b>6. Sécurité</b>Les mots de passe sont chiffrés (SHA-256) avant enregistrement. Ne partagez jamais d’informations sensibles dans le chat.
<b>7. Contenu IA</b>Les réponses d’une IA peuvent contenir des erreurs : vérifiez les informations importantes.
</div>
<button class="btn" id="mc">J’ai compris</button>
</div></div>

<div id="app" class="hide">
<aside id="side">
  <div class="sh"><div class="brand">NOVA</div>
    <div style="display:flex;gap:6px">
      <button class="ib" id="theme" title="Thème"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.5 1.5M17.5 17.5L19 19M5 19l1.5-1.5M17.5 6.5L19 5"/></svg></button>
      <button class="ib" id="btnSettings" title="Paramètres"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-2 2 2 2 0 01-2-2v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83 0 2 2 0 010-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H3a2 2 0 01-2-2 2 2 0 012-2h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 010-2.83 2 2 0 012.83 0l.06.06a1.65 1.65 0 001.82.33H9a1.65 1.65 0 001-1.51V3a2 2 0 012-2 2 2 0 012 2v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 0 2 2 0 010 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1H21a2 2 0 012 2 2 2 0 01-2 2h-.09a1.65 1.65 0 00-1.51 1z"/></svg></button>
    </div>
  </div>
  <button class="newc" id="newc">+ Nouvelle conversation</button>
  <div id="hist"></div>
  <div class="su"><div class="av" id="uav"></div><div id="uname"></div>
    <button class="ib" id="btBtn" title="Appareils Bluetooth"><svg viewBox="0 0 24 24"><path d="M6.5 6.5l11 11L12 23V1l5.5 5.5-11 11"/></svg></button>
    <button class="ib" id="out" title="Déconnexion"><svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9"/></svg></button>
  </div>
</aside>
<main id="main">
  <div class="top"><button class="ib" id="burger"><svg viewBox="0 0 24 24"><path d="M3 6h18M3 12h18M3 18h18"/></svg></button>
  <h2 id="ttl">Nouvelle conversation</h2>
  <button class="ib" id="a4Btn" title="Vue A4"><svg viewBox="0 0 24 24"><rect x="4" y="2" width="16" height="20" rx="2"/><path d="M8 6h8M8 10h8M8 14h5"/></svg></button>
  <button class="ib" id="clr" title="Supprimer cette conversation"><svg viewBox="0 0 24 24"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14"/></svg></button>
  </div>
  <div id="msgs"><div class="in" id="list"></div></div>
  <div class="comp"><div class="cbox">
    <div id="chips"></div>
    <div class="row">
      <button class="ib" id="bImg" title="Joindre une photo"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="9" cy="9" r="2"/><path d="M21 15l-5-5L5 21"/></svg></button>
