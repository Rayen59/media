<script>
'use strict';
const $ = s => document.querySelector(s);
const st = {
  get(k){ try{ return JSON.parse(localStorage.getItem(k)) }catch(e){ return null } },
  set(k,v){ try{ localStorage.setItem(k,JSON.stringify(v)); return true }catch(e){ return false } },
  del(k){ try{ localStorage.removeItem(k) }catch(e){} }
};
function toast(t){ const e=$('#toast'); e.textContent=t; e.classList.add('on'); setTimeout(()=>e.classList.remove('on'),2400) }

// ===== SETTINGS STATE =====
let SETTINGS = st.get('nova_settings') || {
  theme:'dark', view:'chat', anim:true, autoClose:true, typing:true,
  btAuto:false, speed:'normal', compact:false,
  model:'nova-pro', temp:0.7, tokens:2048, dev:false, logs:false, stream:false
};
// backward compat
if(SETTINGS.btAuto === undefined && SETTINGS.btauto !== undefined) SETTINGS.btAuto = SETTINGS.btauto;
function saveSettings(){ st.set('nova_settings', SETTINGS) }

// ===== APPLY SETTINGS =====
function applySettings(){
  document.documentElement.dataset.theme = SETTINGS.theme;
  // toggles
  const toggleMap = {
    setAnim: SETTINGS.anim,
    setAutoClose: SETTINGS.autoClose,
    setTyping: SETTINGS.typing,
    setBtAuto: SETTINGS.btAuto,
    setCompact: SETTINGS.compact,
    setDev: SETTINGS.dev,
    setLogs: SETTINGS.logs,
    setStream: SETTINGS.stream
  };
  Object.keys(toggleMap).forEach(id => {
    const el = $('#'+id);
    if(el) el.classList.toggle('on', !!toggleMap[id]);
  });
  // selects / inputs
  const set = (sel, v) => { const e=$(sel); if(e) e.value = v; };
  set('#setTheme', SETTINGS.theme);
  set('#setView', SETTINGS.view);
  set('#setSpeed', SETTINGS.speed);
  set('#setModel', SETTINGS.model);
  set('#setTemp', SETTINGS.temp);
  set('#setTokens', SETTINGS.tokens);
}

// ===== THEME BTN =====
$('#theme').onclick = () => {
  SETTINGS.theme = SETTINGS.theme === 'dark' ? 'light' : 'dark';
  saveSettings(); applySettings();
  toast('Thème ' + (SETTINGS.theme === 'dark' ? 'sombre' : 'clair'));
};

// ===== LOGO ANIM =====
'NOVA'.split('').forEach((c,i)=>{
  const s=document.createElement('span'); s.textContent=c; s.style.animationDelay=(.2+i*.18)+'s'; $('#logo').appendChild(s);
});

// ===== CANVAS =====
const cv=$('#cv'),cx=cv.getContext('2d');
let W,H,pts=[],mx=0,my=0,run=true;
function rs(){ const r=devicePixelRatio||1; W=cv.width=innerWidth*r; H=cv.height=innerHeight*r; cx.setTransform(1,0,0,1,0,0); }
addEventListener('resize', rs); rs();
for(let i=0;i<900;i++){ const y=1-2*(i+.5)/900, r=Math.sqrt(1-y*y), a=i*2.399963; pts.push([Math.cos(a)*r,y,Math.sin(a)*r]); }
addEventListener('pointermove', e=>{ mx=(e.clientX/innerWidth-.5); my=(e.clientY/innerHeight-.5); });
function draw(t){
  if(!run) return;
  t *= .001;
  const fg = getComputedStyle(document.documentElement).getPropertyValue('--fg').trim() || '#fff';
  cx.clearRect(0,0,W,H);
  const R = Math.min(W,H) * (.2 + Math.min(t,2.5)*.06);
  const ry = t*.35 + mx*2, rx = my*1.2 + .3;
  const cy1=Math.cos(ry), sy=Math.sin(ry), cx1=Math.cos(rx), sx=Math.sin(rx);
  cx.fillStyle = fg;
  const out = [];
  for(const p of pts){
    let x=p[0]*cy1+p[2]*sy, z=-p[0]*sy+p[2]*cy1, y=p[1]*cx1-z*sx; z=p[1]*sx+z*cx1;
    const w = 1 + .12*Math.sin(p[1]*7+t*2.2)*Math.sin(p[0]*5-t*1.6);
    const s = 1/(1.8-z*.5);
    out.push([W/2+x*R*w*s*1.4, H*.42+y*R*w*s*1.4, z, s]);
  }
  for(const o of out){ cx.globalAlpha=Math.max(.08,(o[2]+1)/2*.9); cx.beginPath(); cx.arc(o[0],o[1],(o[3]*1.6)*(devicePixelRatio||1),0,7); cx.fill(); }
  cx.globalAlpha=.07; cx.strokeStyle=fg; cx.lineWidth=1;
  for(let i=0;i<out.length;i+=6) for(let j=i+6;j<Math.min(i+60,out.length);j+=6){
    const a=out[i], b=out[j];
    if(Math.hypot(a[0]-b[0], a[1]-b[1]) < R*.28){ cx.beginPath(); cx.moveTo(a[0],a[1]); cx.lineTo(b[0],b[1]); cx.stroke(); }
  }
  for(let k=0;k<3;k++){
    const p = ((t*.25+k/3)%1);
    cx.globalAlpha = (1-p)*.25;
    cx.beginPath(); cx.arc(W/2,H*.42,R*(.6+p*1.6),0,7); cx.stroke();
  }
  cx.globalAlpha=1;
  requestAnimationFrame(draw);
}
requestAnimationFrame(draw);

// ===== AUTH =====
let mode='L';
const ok=$('#ok'), go=$('#go');
function setMode(m){
  mode=m;
  $('#tL').classList.toggle('on', m==='L');
  $('#tS').classList.toggle('on', m==='S');
  $('#fN').classList.toggle('hide', m==='L');
  go.textContent = m==='L' ? 'Se connecter' : 'Créer mon compte';
  $('#err').classList.remove('on');
}
$('#tL').onclick = () => setMode('L');
$('#tS').onclick = () => setMode('S');
ok.onchange = () => go.disabled = !ok.checked;
$('#pv').onclick = () => $('#modal').classList.remove('hide');
$('#mc').onclick = () => $('#modal').classList.add('hide');
function err(m){ const e=$('#err'); e.textContent=m; e.classList.add('on'); }
async function hash(s){
  const b = await crypto.subtle.digest('SHA-256', new TextEncoder().encode('nova:'+s));
  return [...new Uint8Array(b)].map(x=>x.toString(16).padStart(2,'0')).join('');
}
go.onclick = async () => {
  const em = $('#email').value.trim().toLowerCase(), pw = $('#pass').value, nm = $('#name').value.trim();
  if(!/^\S+@\S+\.\S+$/.test(em)) return err('Adresse e-mail invalide.');
  if(pw.length < 6) return err('Le mot de passe doit contenir au moins 6 caractères.');
  if(!ok.checked) return err('Vous devez accepter les règles de confidentialité.');
  let users = st.get('nova_users') || {};
  const h = await hash(pw);
  if(mode === 'S'){
    if(!nm) return err('Veuillez indiquer votre nom.');
    if(users[em]) return err('Un compte existe déjà avec cet e-mail.');
    users[em] = { name:nm, h }; st.set('nova_users', users);
  } else {
    if(!users[em] || users[em].h !== h) return err('E-mail ou mot de passe incorrect.');
  }
  st.set('nova_session', em);
  enter(em, users[em].name);
};
['email','pass','name'].forEach(i => $('#'+i).addEventListener('keydown', e=>{
  if(e.key==='Enter' && !go.disabled) go.click();
}));

// ===== APP =====
let me, D, cur, pending = [];
function save(){
  if(!st.set('d_'+me, D)){
    D.chats.forEach(c => c.msgs.forEach(m => m.files && m.files.forEach(f => delete f.url)));
    st.set('d_'+me, D);
  }
}
function enter(em, name){
  me = em;
  D = st.get('d_'+em) || { chats:[] };
  if(!D.chats) D.chats = [];
  $('#uname').textContent = name;
  $('#uav').textContent = name[0].toUpperCase();
  const i = $('#intro');
  i.style.transition = 'opacity .7s, transform .7s';
  i.style.opacity = 0; i.style.transform = 'scale(1.05)';
  setTimeout(() => {
    i.classList.add('hide');
    run = false;
    $('#app').classList.remove('hide');
    cur = D.chats[0] ? D.chats[0].id : null;
    if(!cur) newChat(); else renderAll();
    applySettings();
    updateSettingsInfo();
    if(SETTINGS.btAuto) setTimeout(() => startScan(true), 800);
  }, 650);
}
function newChat(){
  const c = { id: Date.now()+''+Math.random(), title:'Nouvelle conversation', msgs:[] };
  D.chats.unshift(c); cur = c.id; save(); renderAll(); closeSide();
}
const chat = () => D.chats.find(c => c.id === cur);
function renderHist(){
  const h = $('#hist'); h.innerHTML = '';
  D.chats.forEach((c,i) => {
    const d = document.createElement('div');
    d.className = 'hi' + (c.id===cur?' on':'');
    d.style.animationDelay = i*.04 + 's';
    const s = document.createElement('span'); s.textContent = c.title;
    const b = document.createElement('button'); b.textContent = '×'; b.title = 'Supprimer';
    b.onclick = (e) => { e.stopPropagation(); delChat(c.id); };
    d.onclick = () => { cur = c.id; renderAll(); closeSide(); };
    d.append(s, b); h.appendChild(d);
  });
}
function delChat(id){
  D.chats = D.chats.filter(c => c.id !== id);
  if(!D.chats.length){ newChat(); return; }
  if(cur === id) cur = D.chats[0].id;
  save(); renderAll();
}
$('#clr').onclick = () => delChat(cur);
$('#newc').onclick = newChat;
$('#burger').onclick = (e) => {
  e.stopPropagation();
  $('#side').classList.toggle('open');
};
$('#out').onclick = () => { st.del('nova_session'); location.reload(); };

// ===== PANEL AUTO-CLOSE (fix) =====
// Ferme le panneau uniquement si le clic est vraiment en dehors du panneau et des boutons concernés
document.addEventListener('click', (e) => {
  const side = $('#side');
  if(!side.classList.contains('open')) return;
  if(innerWidth > 760) return;
  // Si clic sur burger, ne pas fermer (le burger toggle)
  if($('#burger').contains(e.target)) return;
  // Si clic sur un bouton qui ouvre un panneau, ne pas fermer
  if($('#theme').contains(e.target)) return;
  if($('#btnSettings').contains(e.target)) return;
  if($('#btBtn').contains(e.target)) return;
  if($('#newc').contains(e.target)) return;
  // Si clic dans le side, ne pas fermer
  if(side.contains(e.target)) return;
  // Sinon fermer
  closeSide();
});
function closeSide(){ $('#side').classList.remove('open'); }
addEventListener('resize', () => { if(innerWidth > 760) closeSide(); });

// ===== MESSAGES =====
function msgEl(m){
  const w = document.createElement('div');
  w.className = 'm ' + (m.role==='user'?'u':'b');
  const a = document.createElement('div'); a.className='av';
  a.textContent = m.role==='user' ? $('#uav').textContent : 'N';
  const b = document.createElement('div'); b.className='bub';
  if(m.files && m.files.length){
    const at = document.createElement('div'); at.className='att';
    m.files.forEach(f => {
      if(f.url && f.type.startsWith('image/')){ const im=document.createElement('img'); im.src=f.url; at.appendChild(im); }
      else { const x=document.createElement('div'); x.className='fl'; x.textContent='📎 '+f.name; at.appendChild(x); }
    });
    b.appendChild(at);
  }
  if(m.text){ const t=document.createElement('div'); t.className='txt'; t.textContent=m.text; b.appendChild(t); }
  const d = document.createElement('button'); d.className='del'; d.textContent='×'; d.title='Supprimer le message';
  d.onclick = () => {
    w.style.transition='.3s'; w.style.opacity=0; w.style.transform='translateX(20px)';
    setTimeout(() => {
      const c = chat(); c.msgs = c.msgs.filter(x=>x.id!==m.id); save(); renderAll();
    }, 280);
  };
  b.appendChild(d); w.append(a,b);
  return w;
}
function renderMsgs(){
  const l = $('#list'), c = chat();
  l.innerHTML = '';
  $('#ttl').textContent = c.title;
  if(!c.msgs.length){
    l.innerHTML = '<div class="empty"><div class="logo" style="font-size:40px"><span style="animation:none;opacity:1;transform:none;filter:none">NOVA</span></div><p>Comment puis-je vous aider aujourd’hui ?</p><div class="sug"></div></div>';
    ['Explique-moi l’IA simplement','Écris un e-mail professionnel','Idées de projet innovant'].forEach(s => {
      const b = document.createElement('button'); b.textContent = s;
      b.onclick = () => { $('#inp').value = s; send(); };
      l.querySelector('.sug').appendChild(b);
    });
    return;
  }
  c.msgs.forEach(m => l.appendChild(msgEl(m)));
  scrollD();
}
function renderAll(){ renderHist(); renderMsgs(); }
function scrollD(){ const m=$('#msgs'); m.scrollTop = m.scrollHeight; }

// ===== A4 VIEW =====
$('#a4Btn').onclick = () => { renderA4(); $('#a4').classList.remove('hide'); };
$('#a4Close').onclick = () => $('#a4').classList.add('hide');
function renderA4(){
  const c = chat(), body = $('#a4Body');
  if(!c || !c.msgs.length){
    body.innerHTML = '<div class="a4-page"><p style="color:var(--mut);text-align:center;padding:60px 0">Aucun message dans cette conversation.</p></div>';
    return;
  }
  let html = '';
  c.msgs.forEach(m => {
    html += '<div class="a4-page">';
    html += '<div style="font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--mut);margin-bottom:10px">' + (m.role==='user'?'Vous':'NOVA') + '</div>';
    if(m.files && m.files.length){
      m.files.forEach(f => {
        if(f.url && f.type.startsWith('image/')) html += '<img src="'+f.url+'" style="max-width:100%;border-radius:8px;margin-bottom:8px;border:1px solid var(--line)">';
        else html += '<div style="display:inline-block;border:1px solid var(--line);border-radius:6px;padding:4px 10px;font-size:12px;margin-bottom:8px">📎 '+f.name+'</div>';
      });
    }
    if(m.text) html += '<div style="white-space:pre-wrap;font-size:14px;line-height:1.7">' + m.text.replace(/</g,'&lt;').replace(/>/g,'&gt;') + '</div>';
    html += '</div>';
  });
  body.innerHTML = html;
}

// ===== RESPONSES =====
const R = [
  [/bonjour|salut|hello|coucou/i,'Bonjour ! Ravi de vous retrouver. Sur quoi souhaitez-vous travailler aujourd’hui ?'],
  [/e-?mail|mail/i,'Voici une base :\n\nObjet : Proposition de collaboration\n\nBonjour,\n\nJe me permets de vous contacter afin de vous présenter notre projet. Seriez-vous disponible pour un échange cette semaine ?\n\nCordialement'],
  [/ia|intelligence/i,'Une IA apprend à partir de très nombreux exemples pour repérer des motifs, puis les utilise pour comprendre vos demandes et y répondre. Imaginez un assistant qui a beaucoup lu et qui s’adapte à votre question.'],
  [/idée|projet/i,'Trois pistes :\n1. Un assistant vocal pour les personnes âgées.\n2. Une application qui résume vos documents.\n3. Un tableau de bord personnel qui automatise vos tâches répétitives.'],
  [/merci/i,'Avec plaisir ! N’hésitez pas si vous avez d’autres questions.'],
  [/bluetooth/i,'Le Bluetooth est une technologie sans fil à courte portée. Utilisez le bouton Bluetooth (icône dans le pied du panneau) pour rechercher et lier des appareils à proximité.']
];
function reply(txt, files){
  if(files && files.length && !txt) return 'J’ai bien reçu ' + files.length + ' pièce(s) jointe(s). Que souhaitez-vous que j’en fasse ?';
  for(const r of R) if(r[0].test(txt)) return r[1];
  return 'Bonne question. Voici ma lecture : « ' + txt.slice(0,80) + (txt.length>80?'…':'') + ' ». Pouvez-vous préciser votre objectif pour que je vous donne une réponse plus utile ?';
}
let busy = false;
function send(){
  if(busy) return;
  const i = $('#inp'), txt = i.value.trim();
  if(!txt && !pending.length) return;
  const c = chat(), files = pending.map(f => ({ name:f.name, type:f.type, url:f.url }));
  c.msgs.push({ id:Date.now()+'u', role:'user', text:txt, files });
  if(c.title === 'Nouvelle conversation' && txt) c.title = txt.slice(0,32);
  i.value = ''; i.style.height = 'auto'; pending = []; renderChips();
  save(); renderAll(); busy = true;
  const l = $('#list'), w = document.createElement('div');
  w.className = 'm b';
  w.innerHTML = '<div class="av">N</div><div class="bub"><div class="txt"><div class="dots"><span></span><span></span><span></span></div></div></div>';
  l.appendChild(w); scrollD();
  const speedMap = { rapide:400, normal:1200, lent:2400 };
  const baseDelay = speedMap[SETTINGS.speed] || 1200;
  setTimeout(() => {
    const full = reply(txt, files), tx = w.querySelector('.txt');
    tx.textContent = ''; let k = 0;
    const step = SETTINGS.stream ? 4 : 2;
    const iv = setInterval(() => {
      k += step; tx.textContent = full.slice(0,k); scrollD();
      if(k >= full.length){
        clearInterval(iv);
        c.msgs.push({ id:Date.now()+'b', role:'bot', text:full });
        save(); busy = false; renderAll();
        if(SETTINGS.logs) console.log('[NOVA] réponse', { model:SETTINGS.model, temp:SETTINGS.temp, tokens:SETTINGS.tokens });
      }
    }, SETTINGS.stream ? 8 : 18);
  }, baseDelay + Math.random()*400);
}
$('#send').onclick = send;
$('#inp').addEventListener('keydown', e => {
  if(e.key==='Enter' && !e.shiftKey){ e.preventDefault(); send(); }
});
$('#inp').addEventListener('input', e => {
  e.target.style.height = 'auto'; e.target.style.height = e.target.scrollHeight+'px';
});

// ===== FILES =====
$('#bImg').onclick = () => $('#fImg').click();
$('#bFile').onclick = () => $('#fAny').click();
function addF(fl){
  [...fl].forEach(f => {
    if(f.size > 8e6) return toast('Fichier trop volumineux (8 Mo max)');
    if(f.type.startsWith('image/') && f.size < 1.5e6){
      const r = new FileReader();
      r.onload = () => { pending.push({ name:f.name, type:f.type, url:r.result }); renderChips(); };
      r.readAsDataURL(f);
    } else {
      pending.push({ name:f.name, type:f.type||'file', url:null });
      renderChips();
    }
  });
}
$('#fImg').onchange = e => { addF(e.target.files); e.target.value = ''; };
$('#fAny').onchange = e => { addF(e.target.files); e.target.value = ''; };
function renderChips(){
  const c = $('#chips'); c.innerHTML = '';
  pending.forEach((f,i) => {
    const d = document.createElement('div'); d.className = 'chip';
    if(f.url && f.type.startsWith('image/')){ const im=document.createElement('img'); im.src=f.url; d.appendChild(im); }
    const s = document.createElement('span'); s.textContent = f.name;
    const b = document.createElement('button'); b.textContent = '×';
    b.onclick = () => { pending.splice(i,1); renderChips(); };
    d.append(s,b); c.appendChild(d);
  });
}

// ===== MIC =====
const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
let rec = null;
$('#mic').onclick = () => {
  if(!SR) return toast('La dictée vocale n’est pas disponible sur ce navigateur');
  if(rec){ rec.stop(); return; }
  rec = new SR(); rec.lang = 'fr-FR'; rec.interimResults = true;
  const base = $('#inp').value;
  rec.onresult = e => {
    let s = '';
    for(const r of e.results) s += r[0].transcript;
    $('#inp').value = (base ? base+' ' : '') + s;
  };
  rec.onend = () => { rec = null; $('#mic').classList.remove('rec'); };
  rec.onerror = () => toast('Micro indisponible ou refusé');
  try { rec.start(); $('#mic').classList.add('rec'); } catch(e){ rec = null; }
};

// ===== SETTINGS UI =====
$('#btnSettings').onclick = (e) => {
  e.stopPropagation();
  updateSettingsInfo();
  applySettings();
  $('#settings').classList.remove('hide');
  closeSide();
};
$('#setClose').onclick = () => $('#settings').classList.add('hide');

function updateSettingsInfo(){
  if(!me) return;
  const users = st.get('nova_users') || {};
  const nameEl = $('#setName'), emailEl = $('#setEmail');
  if(nameEl) nameEl.textContent = (users[me] && users[me].name) || '—';
  if(emailEl) emailEl.textContent = me;
  try {
    let size = 0;
    for(const k in localStorage) if(k.startsWith('d_')) size += (localStorage[k]||'').length;
    const s = $('#setStorage');
    if(s) s.textContent = (size/1024).toFixed(1) + ' Ko';
  } catch(e){}
}

// ===== TOGGLES (fix mapping) =====
document.querySelectorAll('#settings .toggle').forEach(t => {
  t.onclick = () => {
    const map = {
      setAnim: 'anim',
      setAutoClose: 'autoClose',
      setTyping: 'typing',
      setBtAuto: 'btAuto',
      setCompact: 'compact',
      setDev: 'dev',
      setLogs: 'logs',
      setStream: 'stream'
    };
    const key = map[t.id];
    if(!key) return;
    SETTINGS[key] = !SETTINGS[key];
    t.classList.toggle('on', !!SETTINGS[key]);
    saveSettings();
    if(key === 'btAuto' && SETTINGS.btAuto) startScan(true);
    toast('Paramètre mis à jour');
  };
});

// ===== SELECTS =====
$('#setTheme').onchange = e => { SETTINGS.theme = e.target.value; saveSettings(); applySettings(); };
$('#setView').onchange = e => { SETTINGS.view = e.target.value; saveSettings(); toast('Vue par défaut : ' + e.target.value.toUpperCase()); };
$('#setSpeed').onchange = e => { SETTINGS.speed = e.target.value; saveSettings(); };
$('#setModel').onchange = e => { SETTINGS.model = e.target.value; saveSettings(); };
$('#setTemp').oninput = e => { SETTINGS.temp = parseFloat(e.target.value) || 0; saveSettings(); };
$('#setTokens').oninput = e => { SETTINGS.tokens = parseInt(e.target.value) || 2048; saveSettings(); };

// ===== CHANGE PASSWORD =====
$('#btnChangePw').onclick = () => {
  $('#pwModal').classList.remove('hide');
  $('#oldPw').value = ''; $('#newPw').value = ''; $('#newPw2').value = '';
  $('#pwErr').classList.remove('on');
};
$('#pwCancel').onclick = () => $('#pwModal').classList.add('hide');
$('#pwSave').onclick = async () => {
  const oldPw = $('#oldPw').value, np = $('#newPw').value, np2 = $('#newPw2').value;
  const e = $('#pwErr');
  const showErr = m => { e.textContent = m; e.classList.add('on'); };
  if(np.length < 6) return showErr('Le nouveau mot de passe doit contenir au moins 6 caractères.');
  if(np !== np2) return showErr('Les mots de passe ne correspondent pas.');
  const users = st.get('nova_users') || {};
  const hOld = await hash(oldPw);
  if(!users[me] || users[me].h !== hOld) return showErr('Mot de passe actuel incorrect.');
  users[me].h = await hash(np);
  st.set('nova_users', users);
  $('#pwModal').classList.add('hide');
  toast('Mot de passe modifié avec succès');
};

// ===== EXPORT =====
$('#btnExport').onclick = () => {
  const data = {
    user: me,
    exported: new Date().toISOString(),
    settings: SETTINGS,
    chats: D.chats.map(c => ({
      title: c.title,
      msgs: c.msgs.map(m => ({
        role: m.role,
        text: m.text,
        files: (m.files||[]).map(f => ({ name:f.name, type:f.type }))
      }))
    }))
  };
  const blob = new Blob([JSON.stringify(data,null,2)], { type:'application/json' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'nova-export-' + Date.now() + '.json';
  a.click();
  toast('Export téléchargé');
};

// ===== RESET =====
$('#btnReset').onclick = () => {
  if(!confirm('Effacer toutes les conversations ? Cette action est irréversible.')) return;
  D.chats = []; newChat(); save(); renderAll(); toast('Historique effacé');
};

// ===== BLUETOOTH =====
let btDevices = [], btScanning = false, btConnected = [];
function startScan(silent){
  $('#btPanel').classList.remove('hide');
  const list = $('#btList');
  btScanning = true;
  list.innerHTML = '<div class="scanning"><div class="pulse"></div><p>Recherche d’appareils à proximité…</p></div>';
  btDevices = [];
  setTimeout(() => {
    if(!btScanning) return;
    btScanning = false;
    const found = [
      { name:'NOVA Speaker', type:'audio', rssi:-42 },
      { name:'AirPods Pro', type:'audio', rssi:-58 },
      { name:'Montre Connectée', type:'wearable', rssi:-65 },
      { name:'Clavier BT', type:'input', rssi:-71 },
      { name:'Souris Sans Fil', type:'input', rssi:-78 }
    ];
    btDevices = found.map((d,i) => ({
      ...d, id:'bt_'+i+'_'+Date.now(), connected: btConnected.includes(d.name)
    }));
    renderBT();
    if(silent) toast('Recherche Bluetooth terminée');
  }, 2000 + Math.random()*1000);
}
function renderBT(){
  const list = $('#btList');
  if(!btDevices.length){
    list.innerHTML = '<div class="scanning"><p>Aucun appareil trouvé. Relancez la recherche.</p></div>';
    return;
  }
  list.innerHTML = '';
  btDevices.forEach((d,i) => {
    const el = document.createElement('div');
    el.className = 'dev'; el.style.animationDelay = (i*.05)+'s';
    const ic = d.type==='audio' ? '🔊' : d.type==='wearable' ? '⌚' : d.type==='input' ? '⌨️' : '📶';
    const isConn = btConnected.includes(d.name);
    el.innerHTML = `
      <div class="ic">${ic}</div>
      <div class="info"><b>${d.name}</b><small>${d.rssi} dBm · ${d.type}</small></div>
      <span class="st ${isConn?'on':''}">${isConn?'Lié':'Disponible'}</span>
      <button>${isConn?'Dissocier':'Lier'}</button>
    `;
    el.querySelector('button').onclick = () => {
      if(btConnected.includes(d.name)){
        btConnected = btConnected.filter(n => n !== d.name);
        toast('Appareil dissocié : ' + d.name);
      } else {
        btConnected.push(d.name);
        toast('Appareil lié : ' + d.name);
      }
      renderBT();
    };
    list.appendChild(el);
  });
}
$('#btBtn').onclick = (e) => {
  e.stopPropagation();
  $('#btPanel').classList.remove('hide');
  if(!btDevices.length) startScan(); else renderBT();
  closeSide();
};
$('#btClose').onclick = () => { $('#btPanel').classList.add('hide'); btScanning = false; };
$('#btScan').onclick = () => startScan();
$('#btRefresh').onclick = () => startScan();
$('#btnBTManage').onclick = () => {
  $('#btPanel').classList.remove('hide');
  if(!btDevices.length) startScan(); else renderBT();
};

